# Google Gemini API Key (Required for AI Chatbot)
GEMINI_API_KEY=

# Google OAuth Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Taleem360 Integration
T360_V2_CORE_API_URL=
DAYCARE_INTERNAL_SERVICE_SECRET=

# Server Configuration
PORT=3000
APP_URL=

# Database Configuration for academy multi-tenant
SKILLS_ACADEMY_DATABASE_URL=

# Lead capture (quote + contact forms) — see docs/lead-capture-setup.md
# Apps Script web app URL ending in /exec. Without it the forms fail loudly
# rather than pretending to succeed.
LEAD_WEBHOOK_URL=
# Optional: must match SHARED_SECRET in the Apps Script.
LEAD_SHARED_SECRET=
