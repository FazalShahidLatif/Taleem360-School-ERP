{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/v2/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,DELETE,PATCH,POST,PUT,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/v2/:path*", "dest": "https://taleem360-api-v2.vercel.app/api/v2/:path*" },
    { "src": "/api/:path*", "dest": "/api/:path*" },
    { "src": "/auth/google/callback", "dest": "/auth/google/callback" },
    { "src": "/", "dest": "/static-html/index.html" },
    { "src": "/about", "dest": "/static-html/about.html" },
    { "src": "/pricing", "dest": "/static-html/pricing.html" },
    { "src": "/blog", "dest": "/static-html/blog.html" },
    { "src": "/blog/(.*)", "dest": "/static-html/$1.html" },
    { "src": "/faq", "dest": "/static-html/faq.html" },
    { "src": "/contact", "dest": "/static-html/contact.html" },
    { "src": "/daycare", "dest": "/static-html/daycare.html" },
    { "src": "/biometric-attendance", "dest": "/static-html/biometric-attendance.html" },
    { "src": "/compare", "dest": "/static-html/compare.html" },
    { "src": "/free-resources", "dest": "/static-html/free-resources.html" },
    { "src": "/skills-academy", "dest": "/static-html/skills-academy.html" },
    { "src": "/madrasa", "dest": "/static-html/madrasa.html" },
    { "src": "/white-label", "dest": "/static-html/white-label.html" },
    { "src": "/private-tutors", "dest": "/static-html/private-tutors.html" },
    { "src": "/api", "dest": "/static-html/api.html" },
    { "src": "/ai-resource-studio", "dest": "/static-html/ai-resource-studio.html" },
    { "src": "/support", "dest": "/static-html/support.html" },
    { "src": "/nigeria", "dest": "/static-html/nigeria.html" },
    { "src": "/bangladesh", "dest": "/static-html/bangladesh.html" },
    { "src": "/uae", "dest": "/static-html/uae.html" },
    { "src": "/karachi", "dest": "/static-html/karachi.html" },
    { "src": "/lahore", "dest": "/static-html/lahore.html" },
    { "src": "/islamabad", "dest": "/static-html/islamabad.html" },
    { "src": "/rawalpindi", "dest": "/static-html/rawalpindi.html" },
    { "src": "/peshawar", "dest": "/static-html/peshawar.html" },
    { "src": "/faisalabad", "dest": "/static-html/faisalabad.html" },
    { "src": "/multan", "dest": "/static-html/multan.html" },
    { "src": "/quetta", "dest": "/static-html/quetta.html" },
    { "src": "/privacy", "dest": "/static-html/privacy.html" },
    { "src": "/terms", "dest": "/static-html/terms.html" },
    { "src": "/cookies", "dest": "/static-html/cookies.html" },
    { "src": "/refund-policy", "dest": "/static-html/refund-policy.html" },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": { "X-Robots-Tag": "noindex, follow" }
    }
  ]
}
