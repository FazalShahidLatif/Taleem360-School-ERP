{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "taleem360.online"
        }
      ],
      "destination": "https://www.taleem360.online/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/v2/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,DELETE,PATCH,POST,PUT,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Paddle-Signature" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/v2/:path*", "destination": "https://taleem360-api-v2.vercel.app/api/v2/:path*" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/auth/google/callback", "destination": "/auth/google/callback" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
