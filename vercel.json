{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "taleem360.online"
        }
      ],
      "destination": "https://www.taleem360.online/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/v2/:path*", "destination": "https://taleem360-api-v2.vercel.app/api/v2/:path*" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/auth/google/callback", "destination": "/auth/google/callback" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
